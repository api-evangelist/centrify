   ],
   "paths": {
    "/file/export/rules/webhook/{name}": {
     "post": {
      "summary": "/file/export/rules/webhook/{name}",
      "description": "Exports the information for one or more webhooks to JSON. The information is returned in both a .json file attachment and in the response. The exported information can be imported to a tenant using the [/file/import/rules/webhook](https://developer.delinea.com/reference/fileimportruleswebhook).",
      "operationId": "fileexportruleswebhookname",
      "parameters": [
       {
        "name": "name",
        "in": "path",
        "description": "The base name to assign to the exported file. The endpoint will append \".json\" to this name.",
        "schema": {
         "type": "string"
        },
        "required": true
       }
      ],
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "properties": {
           "export_header": {
            "type": "boolean",
            "description": "Specifies if the webhook's header information should be exported."
           },
           "export_url": {
            "type": "boolean",
            "description": "Specifies if the webhooks URL should be exported."
           },
           "policy_ids": {
            "type": "array",
            "description": "The IDs of the webhooks to export. You can get the IDs of each webhook on the tenant by invoking the [/rules](https://developer.delinea.com/reference/rules) endpoint.",
            "items": {
             "type": "string"
            }
           }
          }
         }
        }
       }
