  "definition": {
   "openapi": "3.1.0",
   "info": {
    "title": "analytics",
    "version": "23.1"
   },
   "servers": [
    {
     "url": "https://example.com/analytics/services/v1.0"
    }
   ],
   "security": [
    {}
   ],
   "paths": {
    "/apis/access_tokens": {
     "post": {
      "summary": "/apis/access_tokens",
      "description": "Creates a new access token for use with analytics APIs.",
      "operationId": "apisaccess_tokens",
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "properties": {
           "name": {
            "type": "string",
            "description": "The name to assign to the token."
           },
           "expiration_time": {
            "type": "string",
            "description": "The date/time when the token should expire. To allow the access token to last forever (i.e. to not have an expiration time), set this parameter to -1."
           },
           "scopes": {
            "type": "array",
            "description": "An array strings corresponding to the scopes to authorize access to with the token.",
            "items": {
             "type": "string"
            }
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{  \n   \"id\":\"c454fb8...\",\n   \"name\":\"Test 101\",\n   \"user_name\":\"demoabc\",\n   \"token\":\"eyJhbGciOiJIUzI...\",\n   \"status\":\"active\",\n   \"expiration_time\":1529006108650,\n   \"creation_time\":1527879324266,\n   \"scopes\":[  \n      \"sensor_registration\",\n      \"content\"\n   ]\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "id": {
             "type": "string",
             "example": "c454fb8..."
            },
            "name": {
             "type": "string",
             "example": "Test 101"
            },
            "user_name": {
             "type": "string",
             "example": "demoabc"
            },
            "token": {
             "type": "string",
             "example": "eyJhbGciOiJIUzI..."
            },
            "status": {
             "type": "string",
             "example": "active"
            },
            "expiration_time": {
             "type": "integer",
             "example": 1529006108650,
             "default": 0
            },
            "creation_time": {
             "type": "integer",
             "example": 1527879324266,
             "default": 0
            },
            "scopes": {
             "type": "array",
             "items": {
              "type": "string",
              "example": "sensor_registration"
             }
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "400",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {}
          }
         }
        }
       }
      },
      "deprecated": false,
      "x-readme": {
       "code-samples": [
        {
         "language": "http",
         "code": "POST https://mytenant.centrify.io/analytics/services/v1.0/apis/access_tokens \n\n{\n   \"name\":\"Test 101\",\n   \"expiration_time\":1529006108650,\n   \"scopes\":[  \n      \"sensor_registration\",\n      \"content\"\n   ]\n}"
        }
       ],
       "samples-languages": [
        "http"
       ]
      }
     }
    }
   },
