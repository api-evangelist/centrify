   ],
   "paths": {
    "/rules/webhook": {
     "post": {
      "summary": "/rules/webhook",
      "description": "Creates a webhook.",
      "operationId": "ruleswebhook",
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "properties": {
           "content_type": {
            "type": "string",
            "description": "Specifies the type of content in the `request_body` parameter."
           },
           "description": {
            "type": "string",
            "description": "A description of the webhook."
           },
           "enabled": {
            "type": "boolean",
            "description": "Specifies if the webhook should be enabled or disabled upon creation."
           },
           "event_type": {
            "type": "string",
            "description": "Specifies the type of Centrify event that will cause the web hook to be invoked. Can be set to \"Analytics.Server.AdaptiveSessionRecording\" or \"SecurityAlert\"."
           },
           "headers": {
            "type": "string",
            "description": "Specifies any header information required to invoke the webhook."
           },
           "method": {
            "type": "string",
            "description": "Specifies the REST verb to use when invoking the webhook (e.g. POST)."
           },
           "name": {
            "type": "string",
            "description": "The name of the webhook."
           },
           "request_body": {
            "type": "string",
            "description": "The body of the request to send in the webhook."
           },
           "risk_level": {
            "type": "string",
            "description": "Specifies the risk level to send in the webhook."
           },
           "URL": {
            "type": "string",
            "description": "The URL of the webhook to invoke."
           }
          }
         }
        }
       }
      },
      "responses": {
       "204": {
        "description": "204",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "HTTP/1.1 204 No Content\nServer: Apache-Coyote/1.1\nDate: Fri, 18 May 2018 17:02:08 GMT\nCache-Control: no-cache, no-store, max-age=0, must-revalidate\nPragma: no-cache\nExpires: 0\nStrict-Transport-Security: max-age=31536000 ; includeSubDomains\nX-XSS-Protection: 1; mode=block\nX-Frame-Options: DENY\nX-Content-Type-Options: nosniff\n\n"
           }
          }
         }
        }
       },
       "400": {
        "description": "400",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {}
          }
         }
        }
       }
      },
      "deprecated": false,
      "x-readme": {
       "code-samples": [
        {
         "language": "http",
         "code": "POST https://mytenant.centrify.io/analytics/services/v1.0/rules/webhook HTTP/1.1\n\n{  \n   \"name\":\"My Slack WebHook\",\n   \"description\":\"\",\n   \"url\":\"https://hooks.slack.com/services/REDACTED.../B9...\",\n   \"method\":\"POST\",\n   \"content_type\":\"application/json\",\n   \"headers\":\"\",\n   \"request_body\":\"{\\n  \\\"attachments\\\": [\\n    {\\n      \\\"author_name\\\": \\\"Centrify Analytics\\\",\\n      \\\"author_link\\\": \\\"https://${tenant_id}-${system.podscape}.${system.domain}/analytics\\\",\\n      \\\"author_icon\\\": \\\"https://${tenant_id}-${system.podscape}.${system.domain}/analytics/ui/favicons/favicon.png\\\",\\n      \\\"title\\\": \\\"Anomaly Session Found from Centrify Analytics\\...\",\n   \"enabled\":true,\n   \"event_type\":\"Analytics.Server.AdaptiveSessionRecording\",\n   \"risk_level\":\"Low\"\n}"
        }
       ],
       "samples-languages": [
        "http"
       ]
      }
     }
    }
   },
