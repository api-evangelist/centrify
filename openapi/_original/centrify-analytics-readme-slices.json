       "400": {
        "description": "400",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {}
          }
         }
        }
       }
      },
      "deprecated": false,
      "x-readme": {
       "code-samples": [
        {
         "language": "http",
         "code": "POST https://mytenant.centrify.io/analytics/services/v1.0/file/export/rules/webhook/MyDemo\n\n{  \n   \"policy_ids\":[  \n      \"a5e7...\"\n   ],\n   \"export_url\":true,\n   \"export_header\":true\n}"
        }
       ],
