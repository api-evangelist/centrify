     "url": "https://example.com/ServerAgent"
    }
   ],
   "security": [
    {}
   ],
   "paths": {
    "/ServerAgent/AddEnrollmentCode": {
     "post": {
      "summary": "/ServerAgent/AddEnrollmentCode",
      "description": "Generates a new enrollment code for use when joining multiple computers to the Infrastructure Services, without the need to provide a user name and password.",
      "operationId": "serveragentaddenrollmentcode",
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "properties": {
           "AllowAllSets": {
            "type": "boolean",
            "description": "Specifies if all sets are allowed."
           },
           "AllowMemberShip": {
            "type": "boolean",
            "description": "Specifies if membership is allowed."
           },
           "Description": {
            "type": "string",
            "description": "A description for the code's intended usage."
           },
           "NeverExpire": {
            "type": "boolean",
            "description": "Specifies whether the code should expire."
           },
           "NoMaxUseCount": {
            "type": "boolean",
            "description": "Specifies whether a maximum use count applies."
           },
           "Owner": {
            "type": "string",
            "description": "The name of the owner's role."
           },
           "OwnerID": {
            "type": "string",
            "description": "The ID of the owner."
           },
           "OwnerType": {
            "type": "string",
            "description": "The name of the owner type."
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{  \n   \"success\":true,\n   \"Result\":{  \n      \"EnrollmentCode\":\"123abcd10-28AB-4CE8-A010-34C7AAD5CED0\"\n   },\n   \"Message\":null,\n   \"MessageID\":null,\n   \"Exception\":null,\n   \"ErrorID\":null,\n   \"ErrorCode\":null,\n   \"InnerExceptions\":null\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "success": {
             "type": "boolean",
             "example": true,
             "default": true
            },
            "Result": {
             "type": "object",
             "properties": {
              "EnrollmentCode": {
               "type": "string",
               "example": "123abcd10-28AB-4CE8-A010-34C7AAD5CED0"
              }
             }
            },
            "Message": {},
            "MessageID": {},
            "Exception": {},
            "ErrorID": {},
            "ErrorCode": {},
            "InnerExceptions": {}
           }
          }
         }
        }
       },
       "400": {
        "description": "400",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {}
          }
         }
        }
       }
      },
      "deprecated": false,
      "x-readme": {
       "code-samples": [
        {
         "language": "http",
         "code": "POST /ServerAgent/AddEnrollmentCode\n\n{  \n   \"NeverExpire\":true,\n   \"NoMaxUseCount\":true,\n   \"OwnerID\":\"sysadmin\",\n   \"OwnerType\":\"Role\",\n   \"Owner\":\"System Administrator\",\n   \"Description\":\"test\",\n   \"AllowMemberShip\":true,\n   \"AllowAllSets\":true\n}"
        }
       ],
       "samples-languages": [
        "http"
       ]
      }
     }
    }
   },
