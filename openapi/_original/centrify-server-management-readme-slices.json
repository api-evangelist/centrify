   "paths": {
    "/RunDiscovery": {
     "post": {
      "summary": "Run Discovery",
      "description": "Runs a discovery process for a discovery profile.",
      "operationId": "run-discovery",
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "properties": {
           "BypassAddAccountCheck": {
            "type": "boolean"
           },
           "Profiles": {
            "properties": {
             "ID": {
              "type": "string",
              "description": "The ID of the discovery profile to run a discovery job on."
             },
             "Passwords": {
              "properties": {
               "Domain": {
                "type": "string",
                "description": "The domain on which to run discovery"
               },
               "Password": {
                "type": "string",
                "description": "The password to access the domain."
               }
              },
              "required": [],
              "type": "object"
             }
            },
            "required": [],
            "type": "object",
            "description": "Lists the profiles to run discoveries on."
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{  \n   \"success\":true,\n   \"Result\":null,\n   \"Message\":null,\n   \"MessageID\":null,\n   \"Exception\":null,\n   \"ErrorID\":null,\n   \"ErrorCode\":null,\n   \"InnerExceptions\":null\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "success": {
             "type": "boolean",
             "example": true,
             "default": true
            },
            "Result": {},
            "Message": {},
            "MessageID": {},
            "Exception": {},
            "ErrorID": {},
            "ErrorCode": {},
            "InnerExceptions": {}
           }
          }
         }
        }
       },
       "400": {
        "description": "400",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {}
          }
         }
        }
       }
      },
      "deprecated": false,
      "x-readme": {
       "code-samples": [
        {
         "language": "http",
         "code": "POST /ServerManage/RunDiscovery\n\n{  \n   \"Profiles\":[  \n      {  \n         \"ID\":\"9abcdefg-533e-4d11-a92b-15401c65bb40\",\n         \"Passwords\":[  \n            {  \n               \"Domain\":\"centrify.com\",\n               \"Password\":\"MyPassword\"\n            }\n         ]\n      }\n   ],\n   \"BypassAddAccountCheck\":false\n}"
        }
